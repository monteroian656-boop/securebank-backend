// Los nombres de campo deben coincidir exactamente con frontend/src/types/shared.ts
// Campos que el frontend nunca consume directamente (passwordHash, mfaEnabled) sí pueden diferir.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuditResult {
  success
  failure
}

enum RiskLevel {
  low
  medium
  high
}

// HU-08 / HU-09: cada entidad bancaria cliente es un tenant aislado.
// Todas las tablas con datos operativos cuelgan de un tenantId.
model Tenant {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users           User[]
  roles           Role[]
  auditLogs       AuditLogEntry[]
  slaMetrics      SlaMetric[]
  securityPolicy  SecurityPolicy?

  @@map("tenants")
}

// HU-04 / HU-05: roles con permisos específicos por entidad.
model Role {
  id          String   @id @default(cuid())
  name        String
  permissions String[]
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  changes     RoleChangeEntry[]

  @@unique([tenantId, name])
  @@map("roles")
}

model User {
  id                  String    @id @default(cuid())
  fullName            String
  email               String    @unique
  passwordHash        String
  mfaEnabled          Boolean   @default(true)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  roleId              String
  role                Role      @relation(fields: [roleId], references: [id])
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now())

  roleChanges         RoleChangeEntry[] @relation("ChangedBy")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// HU-16: una fila por sesión (login) activa.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("sessions")
}

// HU-03: enlace de restablecimiento de contraseña de un solo uso.
model PasswordResetToken {
  token     String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// HU-06 / HU-10: registro de auditoría de accesos.
model AuditLogEntry {
  id        String      @id @default(cuid())
  userId    String
  action    String
  result    AuditResult
  ipAddress String
  riskLevel RiskLevel
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([tenantId, createdAt])
  @@map("audit_log_entries")
}

// HU-15: historial de cambios a roles y permisos.
model RoleChangeEntry {
  id            String   @id @default(cuid())
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  changedBy     String
  changedByUser User     @relation("ChangedBy", fields: [changedBy], references: [id])
  previousState String
  newState      String
  createdAt     DateTime @default(now())

  @@index([roleId])
  @@map("role_change_entries")
}

// HU-13 / HU-18: métricas de SLA por entidad, para el dashboard y su tendencia.
model SlaMetric {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  availability  Float
  avgResponseMs Int
  breached      Boolean
  recordedAt    DateTime @default(now())

  @@index([tenantId, recordedAt])
  @@map("sla_metrics")
}

// HU-01 / HU-11 / HU-19: parámetros de seguridad configurables por entidad.
model SecurityPolicy {
  tenantId          String  @id
  tenant            Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  minLength         Int     @default(10)
  expirationDays    Int     @default(90)
  requireComplexity Boolean @default(true)
  inactivityDays    Int     @default(60)
  lockoutMinutes    Int     @default(15)

  @@map("security_policies")
}
